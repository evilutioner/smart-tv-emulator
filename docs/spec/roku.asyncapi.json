            "param-events": {
              "type": "string",
              "examples": [
                "+language-changed,+language-changing,+media-player-state-changed,+plugin-ui-run,+plugin-ui-run-script,+plugin-ui-exit,+screensaver-run,+screensaver-exit,+plugins-changed,+sync-completed,+power-mode-changed,+volume-changed,+textedit-opened,+textedit-closed,+textedit-changed,+device-name-changed,+device-location-changed,+audio-setting-changed,+audio-settings-invalidated,+user-profile-changed,+tv-power-volume-control-changed",
