            }
          }
        }
      },
      "ecp-2.query-tv-channels": {
        "name": "query-tv-channels",
        "title": "The tuner's channel list, answered inside the envelope.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
