  "components": {
    "messages": {
      "ecp-2.plugin-ui-run": {
        "name": "plugin-ui-run",
        "title": "A subscribed channel-start notification.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "notify": {
              "type": "string"
            },
            "param-channel-id": {
              "type": "string"
            },
            "param-channel-title": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          }
        }
      },
      "ecp-2.plugin-ui-run-script": {
        "name": "plugin-ui-run-script",
        "title": "A captured channel-script notification; requires a profile template.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "notify": {
              "type": "string"
            },
            "param-channel-id": {
              "type": "string"
            },
            "param-channel-title": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          }
        }
      },
      "ecp-2.plugin-ui-exit": {
        "name": "plugin-ui-exit",
        "title": "A subscribed channel-exit notification.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "notify": {
              "type": "string"
            },
            "param-channel-id": {
              "type": "string"
            },
            "param-channel-title": {
              "type": "string"
            },
            "param-plugin-exit-code": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          }
        }
      },
      "ecp-2.textedit-opened": {
        "name": "textedit-opened",
        "title": "A measured native text field opened.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "notify": {
              "type": "string"
            },
            "param-masked": {
              "type": "string"
            },
            "param-max-length": {
              "type": "string"
            },
            "param-selection-end": {
              "type": "string"
            },
            "param-selection-start": {
              "type": "string"
            },
            "param-text": {
              "type": "string"
            },
            "param-textedit-id": {
              "type": "string",
              "description": "Live field identity increments on opening; closing names the former id."
            },
            "param-textedit-type": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "description": "Subscribed connections have independent notification queues."
        }
      },
      "ecp-2.textedit-changed": {
        "name": "textedit-changed",
        "title": "Native text and collapsed cursor changed.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "notify": {
              "type": "string"
            },
            "param-masked": {
              "type": "string"
            },
            "param-max-length": {
              "type": "string"
            },
            "param-selection-end": {
              "type": "string"
            },
            "param-selection-start": {
              "type": "string"
            },
            "param-text": {
              "type": "string"
            },
            "param-textedit-id": {
              "type": "string",
              "description": "Live field identity increments on opening; closing names the former id."
            },
            "param-textedit-type": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "description": "Subscribed connections have independent notification queues."
        }
      },
      "ecp-2.textedit-closed": {
        "name": "textedit-closed",
        "title": "The native text field closed.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "notify": {
              "type": "string"
            },
            "param-textedit-id": {
              "type": "string",
              "description": "Live field identity increments on opening; closing names the former id."
            },
            "timestamp": {
              "type": "string"
            }
          },
          "description": "Subscribed connections have independent notification queues."
        }
      },
      "ecp-2.param-challenge": {
        "name": "param-challenge",
        "title": "The authentication challenge, sent unprompted as the socket opens.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "notify": {
              "type": "string",
              "enum": [
                "authenticate"
              ],
              "description": "A notification, not a reply: no response or status."
            },
            "param-challenge": {
              "type": "string"
            },
            "param-methods": {
              "type": "array",
              "items": {
                "type": "string",
                "examples": [
                  "client-id",
                  "jwt"
                ],
                "description": "The only param that is not a string. Older firmware sent none, so a client must not depend on it."
              }
            },
            "timestamp": {
              "type": "string",
              "pattern": "[0-9]+\\.[0-9]{3}",
              "description": "Device uptime in seconds as a decimal string; it resets on reboot."
            }
          }
        }
      },
      "ecp-2.authenticate": {
        "name": "authenticate",
        "title": "The answer to the challenge, the only request before it succeeds.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            },
            "request-id": {
              "type": "string",
              "examples": [
                "1",
                "0",
                "abc"
              ],
              "description": "Any string, echoed as response-id like every other request's: the set prescribes no value. The official Roku app for Android numbers its requests from 0, so its authenticate carries \"0\"; other clients start at 1.\nThe same framing rule as after authenticating."
            },
            "param-response": {
              "type": "string",
              "description": "A wrong answer does not end the session: the client may answer the same challenge again, and a right answer then authenticates it."
            }
          },
          "description": "The deadline runs from the open, whatever the client sent meanwhile; an authenticated session idle for 80 s stayed open.\nOnce authenticated, authenticate is no longer a request the session has."
        }
      },
      "ecp-2.response": {
        "name": "response",
        "title": "The envelope every reply arrives in.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "response": {
              "type": "string",
              "enum": [
                "authenticate",
                "key-press",
                "key-down",
                "key-up",
                "query-device-info",
                "request-events",
                "launch",
                "input",
                "query-active-app",
                "query-apps",
                "query-media-player",
                "query-textedit-state",
                "query-audio-device",
                "query-tv-channels",
                "commit-av-sync-offset",
                "query-av-sync-offset",
                "reset-av-sync-offset-all",
                "set-av-sync-offset",
                "query-curr-audio-format",
                "check-link",
                "input",
                "key-down",
                "key-press",
                "key-up",
                "launch",
                "mobile-sas-disconnect",
                "query-tv-active-channel",
                "query-audio-setting",
                "query-audio-settings",
                "capture-screen",
                "query-device-info",
                "generate-issue-id",
                "query-icon",
                "query-info-for-voice-service",
                "query-pq-color-space-settings",
                "query-pq-color-temp-settings",
                "query-pq-options",
                "query-pq-picture-modes",
                "query-pq-picture-settings",
                "query-screensavers",
                "query-themes",
                "query-tv-active-input",
                "query-tv-channels-ex",
                "query-warm-standby",
                "authenticate",
                "request-events",
                "reset-audio-setting",
                "reset-audio-settings",
                "get-mobile-pl-headset-delay",
                "set-mobile-pl-headset-delay",
                "send-intent",
                "send-voice-events",
                "set-audio-output",
                "set-audio-setting",
                "set-pq-color-space-settings",
                "set-pq-color-temp-settings",
                "set-pq-picture-mode",
                "set-pq-picture-settings",
                "set-screensaver",
                "set-textedit-text",
                "set-warm-standby",
                "sync-channels",
                "initiate-becp-pairing",
                "remove-ble-device"
              ],
              "description": "Echoes the request name."
            },
            "response-id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "200",
                "202",
                "204",
                "401",
                "601",
                "400",
                "404"
              ],
              "description": "A decimal string about the request, not the transport: a refusal arrives in a successful frame. 400 is an unusable parameter, 404 an unknown request name, 202 the release of a key not held, 401 a request before authenticating and 601 a wrong challenge answer.\nNothing but authenticate is served before it succeeds."
            },
            "status-msg": {
              "type": "string",
              "enum": [
                "OK",
                "Accepted",
                "No Content",
                "Unauthorized",
                "Invalid Credentials",
                "Bad Request",
                "Not Found"
              ],
              "description": "The status phrase only; the set never explains."
            },
            "content-type": {
              "type": "string",
              "description": "Present only with content-data. Hardware spells it with a quoted charset (text/xml; charset=\"utf-8\", application/json for textedit-state) and the emulator replays what the capture recorded; the 15.2.4 probe kept none."
            },
            "content-data": {
              "type": "string"
            }
          },
          "description": "No space after either JSON separator, reproduced for drivers that compare or hash frames.\nKeys in sorted order, so content-data comes first in a frame that has one."
        }
      },
      "ecp-2.key-press": {
        "name": "key-press",
        "title": "A remote key, pressed and released.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            },
            "request-id": {
              "type": "string",
              "description": "Any string, echoed as response-id and never validated -- a reused \"1\" included."
            },
            "param-key": {
              "type": "string",
              "examples": [
                "Home",
                "home",
                "Lit_a",
                "LIT_a",
                "Stop",
                "Guide",
                "LiveTV",
                "Exit",
                "ClosedCaption",
                "Red",
                "Green",
                "Yellow",
                "Blue"
              ],
              "description": "A button name, or Lit_ and exactly one raw UTF-8 character. Case is ignored, so a client that sends LIT_ works. Nothing is percent-decoded on this wire: Lit_%20 is 400 while a literal space is 200, although over HTTP /keypress/%48ome presses Home. Anything else, or a field spelled key, is 400.\nNames the official Roku app for Android has that the set does not take."
            }
          }
        }
      },
      "ecp-2.key-down": {
        "name": "key-down",
        "title": "A remote key, held.",
