<?xml version="1.0" encoding="UTF-8" ?>
<audio-device>
	<capabilities>
		<all-destinations>wifi-remote,datagram,hdmi,wifi-remote-sas,mobile-sas</all-destinations>
	</capabilities>
	<global>
		<muted>false</muted>
		<volume>100</volume>
		<destination-list>datagram</destination-list>
	</global>
	<destinations>
		<destination name="datagram">
			<muted>false</muted>
			<volume>100</volume>
		</destination>
	</destinations>
	<mobile-sas>
		<min-version>43</min-version>
		<max-version>45</max-version>
	</mobile-sas>
	<rtp-info>
		<rtp-address>192.168.1.100:49179</rtp-address>
		<rtcp-port>5150</rtcp-port>
		<current-buffer-delay-us>0</current-buffer-delay-us>
		<client-versions />
	</rtp-info>
</audio-device>
